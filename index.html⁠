<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ระบบประเมินอาการและแนะนำยาเบื้องต้น</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --teal-900: #0b4f4a;
    --teal-700: #0f766e;
    --teal-600: #0d9488;
    --teal-500: #14b8a6;
    --teal-100: #ccfbf1;
    --teal-50:  #f0fdfa;
    --ink:      #1f2d2c;
    --gray-600: #5b6b6a;
    --gray-300: #d5dedd;
    --gray-100: #f1f5f5;
    --white:    #ffffff;
    --red-700:  #b91c1c;
    --red-50:   #fef2f2;
    --red-200:  #fecaca;
    --amber-800:#92400e;
    --amber-50: #fffbeb;
    --amber-300:#fcd34d;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body { height: 100%; }

  body {
    font-family: 'Noto Sans Thai', 'Sarabun', 'Tahoma', system-ui, sans-serif;
    background: var(--gray-100);
    color: var(--ink);
    line-height: 1.65;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* ---------- Header ---------- */
  header {
    background: linear-gradient(135deg, var(--teal-700), var(--teal-500));
    color: var(--white);
    padding: 28px 20px 56px;
  }
  .header-inner { max-width: 960px; margin: 0 auto; }
  header h1 { font-size: clamp(1.4rem, 4.5vw, 2rem); font-weight: 700; line-height: 1.3; }
  header p  { margin-top: 6px; font-size: 1rem; opacity: .92; }

  /* ---------- Main ---------- */
  main {
    flex: 1;
    width: 100%;
    max-width: 960px;
    margin: -34px auto 0;
    padding: 0 16px 32px;
  }

  .panel {
    background: var(--white);
    border-radius: 18px;
    box-shadow: 0 8px 28px rgba(15, 118, 110, .12);
    padding: 24px 20px 28px;
    min-height: 260px;
  }
  @media (min-width: 700px) { .panel { padding: 32px 36px 36px; } }

  .step-title { font-size: 1.3rem; font-weight: 700; color: var(--teal-900); }
  .step-sub   { margin-top: 2px; color: var(--gray-600); font-size: .98rem; }

  .step-indicator {
    display: flex; gap: 8px; margin-bottom: 20px;
  }
  .step-indicator span {
    flex: 1; height: 6px; border-radius: 999px; background: var(--gray-300);
    transition: background .25s;
  }
  .step-indicator span.active { background: var(--teal-500); }

  /* ---------- Category grid ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 20px;
  }
  @media (min-width: 900px) { .grid { grid-template-columns: repeat(4, 1fr); gap: 16px; } }

  .cat-btn {
    font: inherit;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--teal-900);
    background: var(--teal-50);
    border: 2px solid var(--teal-100);
    border-radius: 14px;
    padding: 26px 12px;
    min-height: 110px;
    display: flex; align-items: center; justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s, transform .1s;
  }
  .cat-btn:hover { background: var(--teal-600); border-color: var(--teal-600); color: var(--white); }
  .cat-btn:active { transform: scale(.97); }

  /* ---------- Symptom list ---------- */
  .back-btn {
    font: inherit;
    font-weight: 600;
    color: var(--teal-700);
    background: transparent;
    border: 2px solid var(--teal-100);
    border-radius: 999px;
    padding: 8px 18px;
    cursor: pointer;
    margin-bottom: 16px;
    transition: background .15s;
  }
  .back-btn:hover { background: var(--teal-50); }

  .list { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
  .sym-btn {
    font: inherit;
    font-size: 1.05rem;
    font-weight: 500;
    text-align: left;
    color: var(--ink);
    background: var(--white);
    border: 2px solid var(--gray-300);
    border-left: 6px solid var(--teal-500);
    border-radius: 12px;
    padding: 16px 18px;
    cursor: pointer;
    transition: background .15s, border-color .15s;
  }
  .sym-btn:hover { background: var(--teal-50); border-color: var(--teal-500); }

  /* ---------- Result ---------- */
  .result-head {
    background: var(--teal-50);
    border: 2px solid var(--teal-100);
    border-radius: 14px;
    padding: 14px 18px;
    margin-top: 6px;
  }
  .result-head small { color: var(--gray-600); display: block; }
  .result-head strong { font-size: 1.2rem; color: var(--teal-900); }

  .result-block {
    margin-top: 14px;
    border: 2px solid var(--gray-300);
    border-radius: 14px;
    padding: 16px 18px;
  }
  .result-block h3 {
    font-size: 1.05rem;
    color: var(--teal-700);
    margin-bottom: 6px;
  }
  .result-block p { white-space: pre-line; font-size: 1.05rem; }
  .result-block.warn {
    background: var(--amber-50);
    border-color: var(--amber-300);
  }
  .result-block.warn h3 { color: var(--amber-800); }

  .primary-btn {
    font: inherit;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--white);
    background: var(--teal-600);
    border: none;
    border-radius: 14px;
    padding: 16px 24px;
    width: 100%;
    margin-top: 22px;
    cursor: pointer;
    transition: background .15s;
  }
  .primary-btn:hover { background: var(--teal-700); }

  /* ---------- Loading / Error ---------- */
  .loading { text-align: center; padding: 48px 0; color: var(--teal-700); font-weight: 500; }
  .spinner {
    width: 46px; height: 46px; margin: 0 auto 16px;
    border: 5px solid var(--teal-100);
    border-top-color: var(--teal-600);
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .error-box {
    background: var(--red-50);
    border: 2px solid var(--red-200);
    color: var(--red-700);
    border-radius: 14px;
    padding: 18px 20px;
    font-weight: 500;
  }
  .error-box .detail { font-weight: 400; font-size: .92rem; margin-top: 6px; word-break: break-word; }
  .retry-btn {
    font: inherit; font-weight: 600;
    margin-top: 14px;
    background: var(--red-700); color: var(--white);
    border: none; border-radius: 10px;
    padding: 10px 20px; cursor: pointer;
  }

  .empty { color: var(--gray-600); padding: 16px 0; }

  /* ---------- Footer disclaimer ---------- */
  footer {
    background: var(--teal-900);
    color: #e6fffb;
    padding: 18px 20px;
    font-size: .95rem;
    text-align: center;
  }
  footer p { max-width: 960px; margin: 0 auto; }

  button:focus-visible { outline: 3px solid var(--teal-500); outline-offset: 2px; }

  .view { animation: fade .25s ease; }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .view { animation: none; }
    .spinner { animation-duration: 2.5s; }
    * { transition: none !important; }
  }
</style>
</head>
<body>

<header>
  <div class="header-inner">
    <h1>ระบบประเมินอาการและแนะนำยาเบื้องต้น</h1>
    <p>เลือกหมวดหมู่และอาการ เพื่อดูคำแนะนำเบื้องต้น</p>
  </div>
</header>

<main>
  <div class="panel" id="app" aria-live="polite"></div>
</main>

<footer>
  <p>คำเตือน: ระบบนี้เป็นการแนะนำเบื้องต้นเท่านั้น ไม่สามารถทดแทนการวินิจฉัยของแพทย์หรือเภสัชกรได้ หากมีอาการรุนแรงควรรีบพบแพทย์</p>
</footer>

<script>
  /* ============ ตั้งค่าแหล่งข้อมูล ============ */
  const CSV_URL = 'https://docs.google.com/spreadsheets/d/10sOdNpxNaZpLflktFkmGjPPZwGekkcWwKI_Y7nNT7fM/edit?usp=drivesdk';

  // true = แถวแรกของชีตเป็นหัวตาราง (จะถูกข้ามไป)
  const HAS_HEADER = true;

  /* แปลงลิงก์ /edit?usp=drivesdk หรือ /edit?usp=sharing ให้เป็น /export?format=csv */
  function toCsvUrl(url) {
    if (/\/export\?/.test(url) || /\/pub\?/.test(url)) return url;
    const m = url.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
    if (!m) return url;
    const gid = url.match(/[#&?]gid=(\d+)/);
    return 'https://docs.google.com/spreadsheets/d/' + m[1] + '/export?format=csv' + (gid ? '&gid=' + gid[1] : '');
  }

  /* แปลงข้อความ CSV เป็น Array 2 มิติ (รองรับเครื่องหมายคำพูดและขึ้นบรรทัดใหม่ในเซลล์) */
  function parseCSV(text) {
    text = text.replace(/^\uFEFF/, '');
    const rows = [];
    let row = [], field = '', inQuotes = false;
    for (let i = 0; i < text.length; i++) {
      const c = text[i];
      if (inQuotes) {
        if (c === '"') {
          if (text[i + 1] === '"') { field += '"'; i++; }
          else inQuotes = false;
        } else field += c;
      } else {
        if (c === '"') inQuotes = true;
        else if (c === ',') { row.push(field); field = ''; }
        else if (c === '\n' || c === '\r') {
          if (c === '\r' && text[i + 1] === '\n') i++;
          row.push(field); field = '';
          rows.push(row); row = [];
        } else field += c;
      }
    }
    if (field !== '' || row.length) { row.push(field); rows.push(row); }
    return rows;
  }

  /* ============ สถานะของแอป ============ */
  const app = document.getElementById('app');
  let data = [];          // [{cat, sym, drug, usage, warn}]
  let categories = [];
  let selectedCat = null;

  /* ============ ตัวช่วยสร้าง DOM ============ */
  function el(tag, opts = {}, children = []) {
    const node = document.createElement(tag);
    if (opts.cls)  node.className = opts.cls;
    if (opts.text !== undefined) node.textContent = opts.text;
    if (opts.onClick) node.addEventListener('click', opts.onClick);
    if (opts.type) node.type = opts.type;
    children.forEach(c => node.appendChild(c));
    return node;
  }
  function render(...nodes) {
    app.innerHTML = '';
    const view = el('div', { cls: 'view' }, nodes);
    app.appendChild(view);
  }
  function indicator(step) {
    const wrap = el('div', { cls: 'step-indicator' });
    for (let i = 1; i <= 3; i++) wrap.appendChild(el('span', { cls: i <= step ? 'active' : '' }));
    return wrap;
  }

  /* ============ หน้าจอต่าง ๆ ============ */
  function showLoading() {
    render(
      el('div', { cls: 'loading' }, [
        el('div', { cls: 'spinner' }),
        el('div', { text: 'กำลังดึงข้อมูลอาการ...' })
      ])
    );
  }

  function showError(err) {
    const box = el('div', { cls: 'error-box', });
    box.appendChild(el('div', { text: 'ไม่สามารถดึงข้อมูลอาการได้ กรุณาตรวจสอบการเชื่อมต่ออินเทอร์เน็ตและการแชร์ชีต (ตั้งค่า "ทุกคนที่มีลิงก์ดูได้") แล้วลองอีกครั้ง' }));
    box.appendChild(el('div', { cls: 'detail', text: 'รายละเอียด: ' + (err && err.message ? err.message : err) }));
    box.appendChild(el('button', { cls: 'retry-btn', text: 'ลองใหม่อีกครั้ง', type: 'button', onClick: loadData }));
    render(box);
  }

  function showCategories() {
    selectedCat = null;
    const grid = el('div', { cls: 'grid' });
    categories.forEach(cat => {
      grid.appendChild(el('button', { cls: 'cat-btn', text: cat, type: 'button', onClick: () => showSymptoms(cat) }));
    });
    render(
      indicator(1),
      el('h2', { cls: 'step-title', text: 'เลือกหมวดหมู่อาการ' }),
      el('p',  { cls: 'step-sub',   text: 'เลือกหมวดหมู่ที่ตรงกับอาการของคุณมากที่สุด' }),
      categories.length ? grid : el('p', { cls: 'empty', text: 'ไม่พบข้อมูลหมวดหมู่ในชีต' })
    );
  }

  function showSymptoms(cat) {
    selectedCat = cat;
    const items = data.filter(r => r.cat === cat);
    const list = el('div', { cls: 'list' });
    items.forEach(r => {
      list.appendChild(el('button', { cls: 'sym-btn', text: r.sym, type: 'button', onClick: () => showResult(r) }));
    });
    render(
      indicator(2),
      el('button', { cls: 'back-btn', text: '← ย้อนกลับ', type: 'button', onClick: showCategories }),
      el('h2', { cls: 'step-title', text: cat }),
      el('p',  { cls: 'step-sub',   text: 'เลือกอาการที่ตรงกับคุณ' }),
      items.length ? list : el('p', { cls: 'empty', text: 'ไม่พบอาการในหมวดหมู่นี้' })
    );
  }

  function block(title, value, extraCls) {
    return el('div', { cls: 'result-block' + (extraCls ? ' ' + extraCls : '') }, [
      el('h3', { text: title }),
      el('p',  { text: value || '-' })
    ]);
  }

  function showResult(r) {
    render(
      indicator(3),
      el('button', { cls: 'back-btn', text: '← ย้อนกลับ', type: 'button', onClick: () => showSymptoms(r.cat) }),
      el('h2', { cls: 'step-title', text: 'ผลการประเมินเบื้องต้น' }),
      el('div', { cls: 'result-head' }, [
        el('small',  { text: r.cat }),
        el('strong', { text: r.sym })
      ]),
      block('ยาที่แนะนำ', r.drug),
      block('วิธีรับประทาน', r.usage),
      block('คำเตือน / ข้อควรระวัง', r.warn, 'warn'),
      el('button', { cls: 'primary-btn', text: 'ประเมินอาการอื่น', type: 'button', onClick: showCategories })
    );
  }

  /* ============ โหลดข้อมูล ============ */
  async function loadData() {
    showLoading();
    try {
      const res = await fetch(toCsvUrl(CSV_URL));
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const text = await res.text();
      if (/^\s*<(!doctype|html)/i.test(text)) {
        throw new Error('ได้รับหน้าเว็บแทนไฟล์ CSV (ชีตอาจยังไม่ได้เปิดการแชร์)');
      }

      let rows = parseCSV(text);
      if (HAS_HEADER) rows = rows.slice(1);

      const out = [];
      let lastCat = '';
      rows.forEach(r => {
        const cat   = (r[0] || '').trim() || lastCat;   // เติมค่าอัตโนมัติถ้าคอลัมน์ A ว่าง
        const sym   = (r[1] || '').trim();
        if (!cat || !sym) return;
        lastCat = cat;
        out.push({
          cat, sym,
          drug:  (r[2] || '').trim(),
          usage: (r[3] || '').trim(),
          warn:  (r[4] || '').trim()
        });
      });

      if (!out.length) throw new Error('ไม่พบข้อมูลในชีต');
      data = out;
      categories = [...new Set(out.map(r => r.cat))];   // ตัดหมวดหมู่ซ้ำ
      showCategories();
    } catch (err) {
      showError(err);
    }
  }

  loadData();
</script>
</body>
</html>
